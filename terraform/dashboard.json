{
  "displayName": "Kestrel",
  "mosaicLayout": {"columns": 12, "tiles": [
    {"xPos": 0, "yPos": 0, "width": 6, "height": 4,
     "widget": {"title": "Pending queue depth",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "kestrel_pending_jobs"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 6, "yPos": 0, "width": 6, "height": 4,
     "widget": {"title": "Jobs by state",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "sum by (state) (kestrel_jobs)"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 0, "yPos": 4, "width": 6, "height": 4,
     "widget": {"title": "Workers by status",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "sum by (status) (kestrel_workers)"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 6, "yPos": 4, "width": 6, "height": 4,
     "widget": {"title": "Cluster CPU / memory allocation ratio",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "{__name__=~\"kestrel_cluster_(cpu|memory)_allocation_ratio\"}"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 0, "yPos": 8, "width": 6, "height": 4,
     "widget": {"title": "Scheduling latency p50 (s)",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "histogram_quantile(0.5, sum by (le) (rate(kestrel_scheduling_latency_seconds_bucket[1m])))"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 6, "yPos": 8, "width": 6, "height": 4,
     "widget": {"title": "Reschedule rate (per second)",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "rate(kestrel_jobs_rescheduled_total[1m])"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 0, "yPos": 12, "width": 6, "height": 4,
     "widget": {"title": "WAL append latency p99 (s)",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate(kestrel_wal_append_latency_seconds_bucket[1m])))"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
,
    {"xPos": 6, "yPos": 12, "width": 6, "height": 4,
     "widget": {"title": "Detector stalls (control-plane pauses)",
       "xyChart": {"dataSets": [{"timeSeriesQuery": {"prometheusQuery": "increase(kestrel_detector_stalls_total[5m])"}, "plotType": "LINE"}],
                   "yAxis": {"scale": "LINEAR"}}}}
  ]}
}
